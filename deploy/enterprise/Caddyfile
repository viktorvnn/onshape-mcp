{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static private_ranges
	}
}

{$MCP_DOMAIN} {
	log {
		output stdout
		format filter {
			request>uri query {
				replace code REDACTED
				replace state REDACTED
			}
			wrap json
		}
	}

	request_body {
		max_size 16MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy onshape-mcp:8080 {
		header_up Host {host}
		health_uri /ready
		health_interval 30s
		health_timeout 5s
		stream_close_delay 5m
	}
}
